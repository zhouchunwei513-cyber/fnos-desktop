{
  "name": "fnos-mac",
  "productName": "FNOS",
  "version": "1.0.0",
  "description": "FNOS 桌面客户端 · macOS 原生规范版",
  "main": "src/main/index.js",
  "author": "FNOS",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac --arm64 --x64 --publish never",
    "dist:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:x64": "electron-builder --mac --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.fnos.client.mac",
    "productName": "FNOS",
    "copyright": "Copyright © 2026 FNOS",
    "asar": true,
    "compression": "normal",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "FNOS-mac-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "LSApplicationCategoryType": "public.app-category.utilities",
        "NSHighResolutionCapable": true,
        "NSSupportsAutomaticGraphicsSwitching": true,
        "CFBundleDisplayName": "FNOS",
        "CFBundleName": "FNOS",
        "NSLocalNetworkUsageDescription": "用于连接局域网内的飞牛 NAS 设备",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "identity": null
    },
    "dmg": {
      "artifactName": "FNOS-mac-${version}-${arch}.${ext}",
      "window": {
        "width": 620,
        "height": 420
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 470,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouchunwei513-cyber/fnos-desktop.git"
  }
}
