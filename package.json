{
  "name": "fnos-client",
  "version": "4.0.61",
  "description": "FNOS Desktop Client",
  "main": "main.js",
  "author": "FNOS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "build": "electron-builder --win nsis --x64",
    "dist:setup": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.fnos.client",
    "productName": "FNOS",
    "copyright": "FNOS",
    "compression": "normal",
    "asar": true,
    "files": [
      "main.js",
      "menu-popup.html",
      "menu-popup.js",
      "menu-popup-preload.js",
      "mpv-player.js",
      "mpv-surface.js",
      "mpv-helper.js",
      "preload.js",
      "embed-shell.html",
      "dialog-preload.js",
      "download-preload.js",
      "live-preload.js",
      "lock-preload.js",
      "settings-preload.js",
      "shell-preload.js",
      "titlebar-inject.js",
      "titlebar-frost.js",
      "logger.js",
      "update-progress-preload.js",
      "update-progress.html",
      "login.html",
      "login.css",
      "login.js",
      "help.html",
      "about.html",
      "dialog.html",
      "dialog.css",
      "dialog.js",
      "error.html",
      "lock.html",
      "lock.css",
      "lock.js",
      "settings.html",
      "settings.css",
      "settings.js",
      "download.html",
      "download.js",
      "shell.html",
      "shell.js",
      "live.html",
      "player.html",
      "vendor/**/*",
      "extensions/**/*",
      "assets/**/*",
      "icon.ico",
      "icon.png",
      "live-icon.png",
      "package.json",
      "subapp-preload.js"
    ],
    "win": {
      "extraResources": [
        {
          "from": "mpv",
          "to": "mpv"
        },
        {
          "from": "mpv-config",
          "to": "mpv-config"
        },
        {
          "from": "bin/uninstaller",
          "to": "uninstaller"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "FNOS-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FNOS",
      "runAfterFinish": true,
      "include": "installer-custom.nsi",
      "artifactName": "FNOS-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
