{
  "name": "fnos-client",
  "version": "2.15.1",
  "description": "FNOS 桌面客户端",
  "main": "main.js",
  "author": "FNOS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "build": "electron-builder --win nsis --x64",
    "dist:setup": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.fnos.client",
    "productName": "FNOS",
    "copyright": "FNOS",
    "compression": "normal",
    "asar": true,
    "files": [
      "main.js",
      "mpv-player.js",
      "mpv-surface.js",
      "mpv-helper.js",
      "preload.js",
      "embed-shell.html",
      "dialog-preload.js",
      "download-preload.js",
      "live-preload.js",
      "lock-preload.js",
      "settings-preload.js",
      "shell-preload.js",
      "titlebar-inject.js",
      "logger.js",
      "login.html",
      "login.css",
      "login.js",
      "help.html",
      "dialog.html",
      "dialog.css",
      "dialog.js",
      "lock.html",
      "lock.css",
      "lock.js",
      "settings.html",
      "settings.css",
      "settings.js",
      "download.html",
      "download.js",
      "shell.html",
      "shell.js",
      "live.html",
      "player.html",
      "vendor/**/*",
      "extensions/**/*",
      "assets/**/*",
      "icon.ico",
      "icon.png",
      "live-icon.png",
      "package.json",
      "subapp-preload.js"
    ],
    "win": {
      "extraResources": [
        {
          "from": "mpv",
          "to": "mpv"
        },
        {
          "from": "mpv-config",
          "to": "mpv-config"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "FNOS-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FNOS",
      "runAfterFinish": true,
      "artifactName": "FNOS-${version}-setup.${ext}"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "FNOS-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "mpv/mac-arm64",
          "to": "mpv/mac-arm64"
        },
        {
          "from": "mpv/mac-x64",
          "to": "mpv/mac-x64"
        },
        {
          "from": "mpv-config",
          "to": "mpv-config"
        }
      ]
    },
    "dmg": {
      "artifactName": "FNOS-${version}-mac-${arch}.dmg"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
